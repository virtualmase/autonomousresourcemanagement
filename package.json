{
  "name": "autonomous-resource-management-reference",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "export": "npm run build && node scripts/export-static.mjs",
    "check:export": "node scripts/export-static.mjs --check",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "check": "npm run build && node scripts/check.mjs && python3 scripts/audit-links.py && python3 scripts/audit-search.py",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "news:collect": "python3 scripts/collect-news.py",
    "test:browser": "playwright test",
    "check:links": "python3 scripts/audit-links.py",
    "check:search": "python3 scripts/audit-search.py"
  },
  "dependencies": {
    "marked": "18.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
